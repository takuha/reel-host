# アカウントごとに1組。このファイルには値を入れず、.env 側に書く。
# 接頭辞がそのまま reel_post.sh に渡すアカウント名になる（AOYAGI_ → aoyagi）。

TAKUHA_IG_USER_ID=
TAKUHA_ACCESS_TOKEN=

AOYAGI_IG_USER_ID=
AOYAGI_ACCESS_TOKEN=

# reel_post.sh refresh でトークンを長期に延長するときに使う。
# Meta アプリの「設定 → ベーシック」にある。全アカウント共通。
# Instagram ログイン方式（REEL_GRAPH_HOST=graph.instagram.com）なら不要。
META_APP_ID=
META_APP_SECRET=
